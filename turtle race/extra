def move_forward():
    t.forward(10)
def turn_right():
    new_heading=t.heading()-10
    t.setheading(new_heading)
def turn_left():
    new_heading=t.heading() + 10
    t.setheading(new_heading)
def move_backwards():
    t.backward(10)
def clear():
    t.clear()
    t.penup()
    t.home()
    t.pendown()